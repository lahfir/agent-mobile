    {
      "annotations": {
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true,
        "readOnlyHint": false
      },
      "description": "Tap a ref, or an x,y point. Prefer a ref. A point is measured from the app frame's top-left; to hit a node by point, tap its center (x + w/2, y + h/2), because `at=x,y` in the tree is its top-left corner. Refs come from the newest tree and stop working after the next action; on STALE_REF, use the newest tree or take a snapshot.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "device": {
            "description": "Device key, name, or id from `devices`; a shut-down device boots by itself",
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "max_depth": {
            "description": "Drop tree nodes deeper than N levels; marks the snapshot incomplete",
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer"
          },
          "target": {
            "description": "A ref, or an x y point in the app frame from its top-left",
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "ref": {
                    "description": "Ref from the most recent snapshot or action reply",
                    "maxLength": 1024,
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "ref"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "type": "object"
              }
            ]
          }
        },
        "required": [
          "target"
        ],
        "type": "object"
      },
      "name": "tap",
      "outputSchema": {
        "properties": {
          "app": {
            "type": "string"
          },
