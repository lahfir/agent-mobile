              "device",
              "emulator",
              "usb",
              "wireless"
            ],
            "type": "string"
          },
          "platform": {
            "description": "Filter by platform",
            "enum": [
              "ios",
              "android"
            ],
            "type": "string"
          },
          "state": {
            "description": "Filter by lowercase device state",
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "name": "devices",
      "outputSchema": {
        "properties": {
          "devices": {
            "items": {
              "properties": {
                "key": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "os": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "platform": {
                  "type": "string"
                },
                "serving": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "state": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "key",
                "name",
                "platform",
                "kind",
                "os",
                "state",
                "serving"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "devices"
        ],
        "type": "object"
      }
