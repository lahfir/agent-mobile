    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "List the simulators, emulators, and phones you can drive. Pass a row's `key` as `device` in later calls. A shut-down device boots on the first call that targets it, so never boot devices with simctl, adb, or emulator yourself. Filters combine with AND.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "description": "Filter by device kind",
            "enum": [
              "simulator",
              "device",
              "emulator",
              "usb",
              "wireless"
            ],
            "type": "string"
          },
          "platform": {
            "description": "Filter by platform",
            "enum": [
              "ios",
              "android"
            ],
            "type": "string"
          },
          "state": {
            "description": "Filter by lowercase device state",
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [],
        "type": "object"
      },
      "name": "devices",
      "outputSchema": {
        "properties": {
          "devices": {
            "items": {
              "properties": {
                "key": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "os": {
                  "type": "string"
                },
                "platform": {
                  "type": "string"
                },
                "serving": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                }
              },
              "required": [
                "key",
                "name",
                "platform",
                "kind"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "devices"
        ],
        "type": "object"
      }
    },
