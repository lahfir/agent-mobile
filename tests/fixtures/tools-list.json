    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false,
        "readOnlyHint": true
      },
      "description": "Read the screen as an accessibility tree with refs. Use it to start, or after a STALE_REF. Every action already returns the next tree, so do not call it after each action. On iOS `app` picks the app to read; on Android it only checks the foreground app, so use `launch` to change apps.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "app": {
            "description": "App id: iOS bundle id or Android package",
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$",
            "type": "string"
          },
          "device": {
            "description": "Device key, name, or id from `devices`; a shut-down device boots by itself",
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "max_depth": {
            "description": "Drop tree nodes deeper than N levels; marks the snapshot incomplete",
            "maximum": 4294967295,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [],
        "type": "object"
      },
